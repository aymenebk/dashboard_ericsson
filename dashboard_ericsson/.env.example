# Copy this file to config.env (the backend reads ./config.env, never this file) and fill it in.
NODE_ENV=development
PORT=3000
DATABASE_LOCAL=mongodb://127.0.0.1:27017/fh-saturation
# Tests use DATABASE_TEST + a suffix per test file, and DROP those databases. The name must contain "test".
DATABASE_TEST=mongodb://127.0.0.1:27017/fh-saturation-test

# At least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Only used by `npm run create-admin`. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- optional ---
# Browser origins allowed to call the API, comma separated (your frontend URL). Empty = no CORS headers.
CORS_ORIGIN=http://localhost:3001
# Requests per IP per 15 minutes for the whole API (default 300) and FAILED logins per IP per 15 minutes (default 10)
RATE_LIMIT_MAX=300
LOGIN_RATE_MAX=10
# Number of reverse proxies in front of the API (nginx, a load balancer...), so that rate limiting sees the real client IP
# TRUST_PROXY=1
# debug | info | warn | error | silent   (default info; silent under Jest)
LOG_LEVEL=info
